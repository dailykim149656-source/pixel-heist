{
  "name": "pixel-heist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "smoke:sam": "tsx --env-file-if-exists=.env.local scripts/smoke-sam.ts",
    "typecheck": "tsc --noEmit",
    "measure:fixtures": "tsx scripts/measure-fixtures.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "predev": "node scripts/sync-fixtures.mjs",
    "prebuild": "node scripts/clean-appledouble.mjs && node scripts/sync-fixtures.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@meta-sam/parser": "^0.1.0",
    "@vercel/analytics": "^2.0.1",
    "next": "^16.4.4",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
